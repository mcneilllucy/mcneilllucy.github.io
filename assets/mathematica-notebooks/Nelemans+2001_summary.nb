Cell["Physical constants", "Section",
 CellChangeTimes->{{3.986517002338469*^9, 
  3.9865170103044987`*^9}},ExpressionUUID->"9f148bda-58d8-4ed3-bee7-\
bbe36b9e91a0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Msol", " ", "=", " ", 
   RowBox[{"2", " ", 
    SuperscriptBox["10", "33"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Rsol", " ", "=", " ", 
   RowBox[{"6.955", " ", 
    SuperscriptBox["10", "10"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"G", "=", 
   RowBox[{"6.67", " ", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"3", " ", 
    SuperscriptBox["10", "10"]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.986514816352263*^9, 3.986514819123695*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"f8e5f573-bfda-424a-aeef-b5050bab9ab6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Reproduction of Nelemans+2001 Fig 1", "Section",
 CellChangeTimes->{{3.885416730312772*^9, 3.88541673886375*^9}, {
  3.98651479791509*^9, 3.986514803352137*^9}, {3.986847634222581*^9, 
  3.98684763470685*^9}, {3.986847734397697*^9, 
  3.986847740104438*^9}},ExpressionUUID->"3f0bca86-0fa1-41c1-ba4c-\
cd4aacfa7f27"],

Cell[CellGroupData[{

Cell["Some definitions", "Subsection",
 CellChangeTimes->{{3.885417076139089*^9, 
  3.885417096756689*^9}},ExpressionUUID->"4b22079d-191d-4c0e-a257-\
cfb572a20054"],

Cell["\<\
Eggleton' s zero - temperature mass\[Dash]radius relation, quoted by Verbunt \
& Rappaport (1988), or Eq. 24:\
\>", "Text",
 CellChangeTimes->{{3.9865173688367043`*^9, 3.986517378161366*^9}, {
  3.98651835713498*^9, 3.986518363204172*^9}, {3.98658254862959*^9, 
  3.9865825494496517`*^9}},ExpressionUUID->"0ff685ea-049e-484b-9822-\
ef7784211ea5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Rcold", "[", "m1_", "]"}], ":=", 
   RowBox[{"0.0114", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"m1", "/", "1.44"}], ")"}], 
        RowBox[{
         RowBox[{"-", "2"}], "/", "3"}]], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"m1", "/", "1.44"}], ")"}], 
        RowBox[{"2", "/", "3"}]]}], ")"}], 
     RowBox[{"1", "/", "2"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"3.5", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"m1", "/", 
           RowBox[{"(", 
            RowBox[{"5.7", " ", 
             SuperscriptBox["10", 
              RowBox[{"-", "4"}]]}], ")"}]}], ")"}], 
         RowBox[{
          RowBox[{"-", "2"}], "/", "3"}]]}], "+", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"5.7", " ", 
           SuperscriptBox["10", 
            RowBox[{"-", "4"}]]}], ")"}], "/", "m1"}], ")"}]}], ")"}], 
     RowBox[{
      RowBox[{"-", "2"}], "/", "3"}]]}]}], ";"}]], "Input",
 CellChangeTimes->{3.986519887528878*^9},
 CellLabel->"In[5]:=",ExpressionUUID->"12089877-3c07-44c7-a271-fe0559c57ab9"],

Cell["\<\
The derivative of the Roche radius in the small q approximation for Paczynski \
(1971) is just 1/3.\
\>", "Text",
 CellChangeTimes->{{3.9865187963370523`*^9, 3.986518801176676*^9}, {
  3.986518869987278*^9, 
  3.986518895198728*^9}},ExpressionUUID->"69388e96-1feb-4c8c-8f43-\
09de137b67de"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Zeta]RL", " ", "=", " ", 
   RowBox[{"1", "/", "3"}]}], ";"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"bf08a74d-8396-4b1d-87b2-dca2efc712be"],

Cell["\<\
The full derivative of the Roche radius in approximation of Eggleton (1983), \
which we will use, is given by\
\>", "Text",
 CellChangeTimes->{{3.986518771338141*^9, 3.986518788215748*^9}, {
  3.986518838818655*^9, 3.986518854940834*^9}, {3.9868513714552917`*^9, 
  3.986851380607194*^9}},ExpressionUUID->"95664c9f-498a-42a9-b1f1-\
b4be12956ab8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Zeta]RLlist", "[", 
    RowBox[{"m1_", ",", "m22_"}], "]"}], "=", 
   RowBox[{
    FractionBox["3", "2"], " ", 
    SuperscriptBox["3", 
     RowBox[{"1", "/", "3"}]], " ", 
    SuperscriptBox["m22", 
     RowBox[{"2", "/", "3"}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"m1", "+", "m22"}], ")"}], 
     RowBox[{"1", "/", "3"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"2", " ", 
         SuperscriptBox["m22", 
          RowBox[{"1", "/", "3"}]]}], 
        RowBox[{"9", " ", 
         SuperscriptBox["3", 
          RowBox[{"1", "/", "3"}]], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"m1", "+", "m22"}], ")"}], 
          RowBox[{"4", "/", "3"}]]}]]}], "+", 
      FractionBox["2", 
       RowBox[{"9", " ", 
        SuperscriptBox["3", 
         RowBox[{"1", "/", "3"}]], " ", 
        SuperscriptBox["m22", 
         RowBox[{"2", "/", "3"}]], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"m1", "+", "m22"}], ")"}], 
         RowBox[{"1", "/", "3"}]]}]]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.9865231861690493`*^9},
 CellLabel->"In[7]:=",ExpressionUUID->"41bc76fc-2f35-4448-a44b-498edf0a9a25"],

Cell["\<\
From polytropic mass radius relation, Soberman 1997 etc. the primary radius \
changes with mass loss according to:\
\>", "Text",
 CellChangeTimes->{{3.9865196605124207`*^9, 3.986519678072197*^9}, {
  3.9868513890893583`*^9, 
  3.9868514070705137`*^9}},ExpressionUUID->"643948c7-4fec-4f17-9590-\
46d3bcb46854"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Zeta]2cold", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "1"}], "/", "3"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8854171285828533`*^9, 3.885417129696515*^9}, 
   3.9865188268710203`*^9, {3.9867992158252163`*^9, 3.9867992183468943`*^9}, {
   3.98679925833939*^9, 3.98679928387192*^9}, 3.9868513845189857`*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"7f7fa822-dbb7-4936-8f7a-50cf9b9b899c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Curve 1: \[OpenCurlyDoubleQuote]dynamical stability boundary\
\[CloseCurlyDoubleQuote] - when radius expands faster than Roche radius upon \
mass loss (change in orbital angular momentum)\
\>", "Subsection",
 CellChangeTimes->{{3.885416742030436*^9, 3.8854167563972597`*^9}, {
  3.9865154751629066`*^9, 3.98651551642708*^9}, {3.9865162830717783`*^9, 
  3.986516315497841*^9}, {3.9865164017421703`*^9, 3.986516402440855*^9}, {
  3.986516534011991*^9, 
  3.9865165346975822`*^9}},ExpressionUUID->"18fa2082-c13d-4d28-8445-\
54e1f5b9ce03"],

Cell[BoxData[
 RowBox[{
  RowBox[{"m1arr", " ", "=", " ", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{"m1", ",", 
      RowBox[{"{", 
       RowBox[{"m1", ",", "0.0001", ",", "1.4", ",", "0.01"}], "}"}]}], "]"}],
     "//", "Flatten"}]}], ";"}]], "Input",
 CellChangeTimes->{3.986513320967183*^9},
 CellLabel->"In[9]:=",ExpressionUUID->"d4e3f52b-94b3-46e8-a150-834ad9ea8dcf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"m1list", "=", "m1arr"}], ";"}]], "Input",
 CellChangeTimes->{{3.986513041099597*^9, 3.9865130473649187`*^9}, 
   3.986513323767806*^9},
 CellLabel->"In[10]:=",ExpressionUUID->"a7cc90a6-9608-43cb-9a29-af62081c61a2"],

Cell[TextData[{
 "Solving Equation 20. for dynamical stability criteria, we get the primary \
mass ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3309e01f-e5c4-4a24-a520-251a72b7f5e6"],
 " for any ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9dbea9be-cdb9-499f-a3fb-19744e19ea9d"],
 " between 0 and 1.4",
 StyleBox["M",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["", "\[CircleDot]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fe869b29-18cc-4349-98f4-3b522ba3560e"]
}], "Text",
 CellChangeTimes->{{3.986526201498373*^9, 3.986526245123754*^9}, {
   3.986851445307568*^9, 3.986851472293633*^9}, 
   3.986851502627833*^9},ExpressionUUID->"9e4bf21d-5fb2-4c48-a2d6-\
077ac912289f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"m2up", "=", 
   RowBox[{"m22", "/.", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", " ", 
            RowBox[{"(", 
             FractionBox[
              RowBox[{"\[Zeta]2cold", "-", 
               RowBox[{"\[Zeta]RLlist", "[", 
                RowBox[{"m1", ",", "m22"}], "]"}]}], "2"], ")"}]}], " ", 
           ")"}], "m1"}], " ", "==", "m22"}], ",", 
        RowBox[{"{", 
         RowBox[{"m22", ",", 
          RowBox[{
           RowBox[{"1", "/", "5"}], " ", "m1"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"m1", ",", "0.0001", ",", "1.4", ",", "0.01"}], "}"}]}], 
     "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.885418041091908*^9, 3.885418041185565*^9}, {
  3.88541811202468*^9, 3.885418192981402*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"97e4d6f2-9d66-4007-8f7e-f705cc0fdd27"],

