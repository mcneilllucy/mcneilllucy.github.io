Cell["This is the dashed boundary in Nelemans + 2001 Fig 1.", "Text",
 CellChangeTimes->{{3.986537604194171*^9, 
  3.9865376226107273`*^9}},ExpressionUUID->"eee433e6-68d3-42b8-a49d-\
372b398a2eed"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The boundary between direct impact and Eddington mass transfer for a disc .\
\>", "Subsection",
 CellChangeTimes->{{3.885417037435679*^9, 3.8854170632205887`*^9}, {
  3.986541086242836*^9, 
  3.986541118007667*^9}},ExpressionUUID->"0f8ad8ec-1334-45ce-8fd0-\
e4c807536d6d"],

Cell[TextData[{
 "For the final line in Nelemans + 2001 Fig 1., around Eq. 6 they explain \
\[OpenCurlyDoubleQuote]The value of q at which the radius of the accretor \
equals rmin is presented as a dotted line in Fig. 1; above this line the \
accretion stream hits the white dwarfs\[CloseCurlyQuote] surface directly and \
no accretion disk is formed\[CloseCurlyDoubleQuote].\nHowever, comparing this \
fit for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "min"], "/", "a"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3ed48368-743d-4a25-bc01-5afecf46db67"],
 " to Lubow & Shu (1975)\[CloseCurlyQuote]s \[Omega]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["", "min"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aa8289b2-d2e1-43cc-a885-52bdc0ca699d"],
 ", I can\[CloseCurlyQuote]t reproduce the Table values (using both natural \
Log, or Log 10)..\nInstead, we use Marsh+2004 (equation 31, A17) but \
replacing ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "h"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "abb75c7d-4496-4021-b01f-ad5adf76b0dc"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "1"], "=", 
    RowBox[{
     SubscriptBox["R", "1"], "/", "a"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ec970ac7-5510-4a9b-ad7c-0340f460688c"],
 " for the limit in the case of disc-fed accretion. Note that this goes into \
the mass transfer rate equation, Eq. 4."
}], "Text",
 CellChangeTimes->{{3.986859408576877*^9, 3.9868594225006104`*^9}, {
  3.986859457139616*^9, 3.986859472764325*^9}, {3.986859508296224*^9, 
  3.986859585664569*^9}, {3.986859726542272*^9, 3.986859785862711*^9}, {
  3.986862702697994*^9, 
  3.986862721162725*^9}},ExpressionUUID->"820ea8ab-3169-4203-b462-\
5deda43eb941"],

Cell[TextData[{
 "The donor fills its Roche lobe, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "2"], "/", "a", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "72d2bde3-33cc-4acb-88c1-e186aa2358be"],
 "= ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "RL"], "/", "a"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "13a35168-d62b-44f6-a54f-a2ffa62e2847"],
 " given by:"
}], "Text",
 CellChangeTimes->{{3.986859893698599*^9, 
  3.986859931737042*^9}},ExpressionUUID->"abc5ec85-f183-4285-8b39-\
26099ab6869c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RRLval", "[", 
    RowBox[{"mp_", ",", "ms_"}], "]"}], "=", 
   FractionBox[
    RowBox[{"0.49", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"mp", "/", "ms"}], ")"}], 
      RowBox[{"2", "/", "3"}]]}], 
    RowBox[{
     RowBox[{"0.6", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"mp", "/", "ms"}], ")"}], 
       RowBox[{"2", "/", "3"}]]}], "+", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"mp", "/", "ms"}], ")"}], 
        RowBox[{"1", "/", "3"}]]}], "]"}]}]]}], ";"}]], "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"d5548e6b-4762-410f-bf18-6f490c4c7182"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"RaNelemans", "[", 
   RowBox[{"m1_", ",", "m22_"}], "]"}], " ", "=", " ", 
  RowBox[{"0.46", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{"(", 
       RowBox[{"m1", "+", "m22"}], ")"}], "m22"], ")"}], 
    RowBox[{
     RowBox[{"-", "1"}], "/", "3"}]]}]}]], "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"c80a3cd5-80fa-4aa0-9659-e9586bf150b1"],

Cell[BoxData[
 FractionBox["0.46`", 
  SuperscriptBox[
   RowBox[{"(", 
    FractionBox[
     RowBox[{"m1", "+", "m22"}], "m22"], ")"}], 
   RowBox[{"1", "/", "3"}]]]], "Output",
 CellChangeTimes->{
  3.986863723228964*^9, {3.9868639151273603`*^9, 3.986863938414751*^9}, 
   3.9868870069879208`*^9, 3.986887059492227*^9},
 CellLabel->"Out[36]=",ExpressionUUID->"b54e3f46-1bff-4ebe-a646-bdccd68c166b"]
}, Open  ]],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "4ea7bc09-a1e1-4494-a087-56d634800a63"],
 "is given by a mass radius relation, the semi major axis can be solved for, \
as a function of donor mass ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["m", "1"], "."}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ecd762f2-dde4-4725-936e-08afd6106309"]
}], "Text",
 CellChangeTimes->{{3.986859944392838*^9, 
  3.9868599871675777`*^9}},ExpressionUUID->"de9bf1f4-b1cb-4f4a-a2a0-\
12ba07f9409a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"aRL", "[", 
    RowBox[{"m1_", ",", "m22_"}], "]"}], "=", 
   RowBox[{"(", 
    FractionBox[
     RowBox[{
      RowBox[{"Rcold", "[", "m22", "]"}], "Rsol"}], 
     RowBox[{"RRLval", "[", 
      RowBox[{"m22", ",", "m1"}], "]"}]], ")"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.986860059649859*^9, 3.9868600847895927`*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"fc14d1c5-7e57-488d-a047-ce565e04f13e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Mdotacc3", "[", 
   RowBox[{"m1_", ",", "m22_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"JJ", "[", 
    RowBox[{"m1", ",", "m22", ",", 
     RowBox[{
      RowBox[{"Rcold", "[", 
       RowBox[{"m22", "/", "Msol"}], "]"}], "Rsol"}]}], "]"}], "m22", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      FractionBox["\[Zeta]2cold", "2"], "-", 
      FractionBox["\[Zeta]RL", "2"], "-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           FractionBox["m22", "m1"]}], ")"}], 
         RowBox[{
          RowBox[{"Rcold", "[", 
           RowBox[{"m1", "/", "Msol"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Rcold", "[", 
             RowBox[{"m22", "/", "Msol"}], "]"}], " ", 
            SuperscriptBox[
             RowBox[{"RRLval", "[", 
              RowBox[{
               RowBox[{"m22", "/", "Msol"}], ",", 
               RowBox[{"m1", "/", "Msol"}]}], "]"}], 
             RowBox[{"-", "1"}]]}], ")"}]}]}], ")"}], 
       RowBox[{"1", "/", "2"}]], "-", 
      FractionBox["m22", "m1"]}], ")"}], 
    RowBox[{"-", "1"}]]}]}]], "Input",
 CellChangeTimes->{{3.9868601373831367`*^9, 3.9868601505087976`*^9}, {
   3.986860285987196*^9, 3.9868603068580627`*^9}, {3.986860369498036*^9, 
   3.986860395873568*^9}, {3.9868619203645153`*^9, 3.9868619233080883`*^9}, 
   3.986862038107493*^9, {3.9868620868444433`*^9, 3.9868620898045397`*^9}, 
   3.9868622264549503`*^9, {3.986862275424344*^9, 3.986862292266942*^9}, {
   3.986862543351664*^9, 3.986862560526608*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"88016b73-4b17-45f5-bd28-9fef23fe3831"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"boundg", "=", 
   RowBox[{
    RowBox[{"m22", "/.", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Mdotacc3", "[", 
           RowBox[{
            RowBox[{"Msol", " ", "m1"}], ",", 
            RowBox[{"Msol", " ", "m22"}]}], "]"}], "==", 
          RowBox[{"-", 
           RowBox[{"Medd22", "[", "m1", "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m22", ",", 
           RowBox[{
            RowBox[{"1", "/", "5"}], " ", "m1"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"m1", ",", "0.0001", ",", "1.4", ",", "0.01"}], "}"}]}], 
      "]"}]}], "//", "Flatten"}]}], ";"}]], "Input",
