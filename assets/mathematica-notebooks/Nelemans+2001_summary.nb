Cell[CellGroupData[{

Cell["\<\
Curve 2: instability from super- Eddington direct impact accretion onto the \
accretor (assuming that mass transfer is conservative)\
\>", "Subsection",
 CellChangeTimes->{{3.885416757621613*^9, 3.885416781901423*^9}, {
  3.986516396061645*^9, 3.98651639757972*^9}, {3.9865164304144697`*^9, 
  3.98651647002945*^9}, {3.9865165311443577`*^9, 3.9865165316544323`*^9}, {
  3.986857937460338*^9, 3.986857950330328*^9}, {3.986858051460368*^9, 
  3.9868580546606197`*^9}},ExpressionUUID->"c1edb3a1-4936-469e-a08b-\
f965d70315dc"],

Cell[TextData[{
 "Here, the accretion rate driven by orbital angular momentum loss from GW \
emission is compared with the Eddington accretion rate of the donor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1d7fb5bc-a6f3-419a-855b-9967aa47333a"],
 ". This is because \[OpenCurlyDoubleQuote]",
 StyleBox["heating of the transferred material, may cause it to expand and \
form a common envelope in which the two white dwarfs most likely merge (Han & \
Webbink 1999).",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote]\n\n... \[OpenCurlyDoubleQuote]",
 StyleBox["Therefore, we impose the additional restriction to have the \
initial mass transfer rate lower than the Eddington accretion limit for the \
companion (\[Tilde] ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "5"}]], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSlant->"Italic",ExpressionUUID->
  "2f8b7f83-25b3-40fd-b313-6f34cfb6f2ff"],
 StyleBox[" M",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["", "\[CircleDot]"], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSlant->"Italic",ExpressionUUID->
  "e6238354-0a07-415d-94bf-94adbae38bf8"],
 StyleBox[" ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["yr", 
    RowBox[{"-", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSlant->"Italic",ExpressionUUID->
  "cb1237f4-371f-4034-bb51-32e50b372684"],
 StyleBox[").",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote]\n\nd",
 StyleBox["J",
  FontSlant->"Italic"],
 "/d",
 StyleBox["t",
  FontSlant->"Italic"],
 " from GR, Eq . 1  (Landau & Lifshitz 1971). Replacing semi major axis a \
with  R/0.46 .. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "99552f98-cdf0-483f-ac97-ccc50afe9839"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d6f1d91f-f55a-4cb2-9b2f-2f85987f8c8a"],
 " comes from Nelemans+2001 Equation 2. This R/0.46 part is compatible with \
what you would get using RRL = Rcold for a given mass ratio q = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["m", "2"], "/", 
    SubscriptBox["m", "1"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5c427a69-7a41-4be8-af7e-1c5c0b45e09c"],
 ", with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", 
    RowBox[{"2", " "}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "72d1535b-4897-44e2-9f86-ac62cd7c6bf6"],
 " being the less massive donor.\n\nNote this is in cgs units - so input \
should be in g, cm. "
}], "Text",
 CellChangeTimes->{{3.986523391820651*^9, 3.986523412629746*^9}, {
  3.9865235554368343`*^9, 3.9865235675523777`*^9}, {3.986847946067153*^9, 
  3.9868479582305527`*^9}, {3.986847988799076*^9, 3.986848073186174*^9}, {
  3.986852170932431*^9, 3.9868523223088493`*^9}, {3.98685236301833*^9, 
  3.986852375334667*^9}},ExpressionUUID->"94e1f035-f599-4b21-b616-\
4e8d98241dad"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"JJ", "[", 
    RowBox[{"m1_", ",", "m22_", ",", "R_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["32", "5"]}], 
    FractionBox[
     SuperscriptBox["G", "3"], 
     SuperscriptBox["c", "5"]], 
    FractionBox[
     RowBox[{"m1", " ", "m22", " ", 
      RowBox[{"(", 
       RowBox[{"m1", " ", "+", " ", "m22"}], ")"}]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        FractionBox["R", "0.46"], 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{"m1", " ", "+", "m22"}], "m22"], ")"}], 
         RowBox[{"1", "/", "3"}]]}], ")"}], "4"]]}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.986523184512229*^9, {3.9868523864478607`*^9, 3.986852387477758*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"4f257c56-d790-4fcc-8a01-ce6ee11ff635"],

Cell[TextData[{
 "For the Eddington mass accretion limit , there are hints in Hann and \
Webbink 1999 Eq. 18. And also details in 4.1 of Nelemans, and also Eq 34 in \
Marsh+2004. At least in Tutukov & Yungelson 1979, it is ~ ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "5"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "41cc38b3-455f-4342-8f63-92cde9c8b8c7"],
 ". \nHere we take a function that depends linearly on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5913ff62-02c4-4c87-86e8-ab4b14cc2845"],
 " and amounts to",
 " \[Tilde] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "5"}]], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSlant->"Plain",ExpressionUUID->"f85a9ca4-38d3-47d8-bc46-44c32c85b692"],
 " M",
 Cell[BoxData[
  FormBox[
   SubscriptBox["", "\[CircleDot]"], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSlant->"Plain",ExpressionUUID->"2a25a86b-cc68-4160-a0b7-6fa1ef872e5a"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["yr", 
    RowBox[{"-", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSlant->"Plain",ExpressionUUID->"6705869a-83f3-4a94-a2e3-3b53cc118abc"],
 ". (without some ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["m", "1"], " ", "dependence"}], ","}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6742e586-6a69-464d-9664-f75edf001e48"],
 " the function droops down)\n\nThe constant is chosen to reproduce Nelemans \
Fig 1. (but should be modified later with correct dependence etc.)"
}], "Text",
 CellChangeTimes->{{3.986524037202743*^9, 3.986524054228611*^9}, {
  3.986524126414215*^9, 3.986524128156204*^9}, {3.9865243621055202`*^9, 
  3.9865243728273497`*^9}, {3.9865245584726973`*^9, 3.9865245628456497`*^9}, {
  3.9865271974929028`*^9, 3.986527198714663*^9}, {3.986527270168242*^9, 
  3.986527296072905*^9}, {3.9865274398201723`*^9, 3.9865274472261553`*^9}, {
  3.986852422306093*^9, 
  3.986852610073615*^9}},ExpressionUUID->"41835b06-d20d-44e7-8d3b-\
c017148de6e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Medd22", "[", "m1_", "]"}], ":=", " ", 
  RowBox[{"5", " ", "4.4", " ", 
   SuperscriptBox["10", 
    RowBox[{"-", "6"}]], 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", "m1", ")"}], "2"], "/", 
    RowBox[{"(", 
     RowBox[{"\[Pi]", " ", 
      SuperscriptBox["10", "7"]}], ")"}]}], "Msol", " "}]}]], "Input",
 CellChangeTimes->{{3.9866729625699663`*^9, 3.986672962851533*^9}, {
   3.986673051104167*^9, 3.9866730512640047`*^9}, {3.98679603941035*^9, 
   3.986796072365006*^9}, 3.986796126230116*^9, {3.9867962052503557`*^9, 
