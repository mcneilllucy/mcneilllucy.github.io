  3.98660584547198*^9}},ExpressionUUID->"4b63cad6-4dd8-45e6-b27f-\
93af9edae8a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"boundff2", "=", 
   RowBox[{"m22", "/.", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"rmin", "[", " ", 
          RowBox[{"m22", "/", "m1"}], "]"}], " ", "==", 
         RowBox[{
          RowBox[{"Rcold", "[", 
           RowBox[{"m1", "/", "Msol"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Rcold", "[", 
             RowBox[{"m22", "/", "Msol"}], "]"}], " ", 
            SuperscriptBox[
             RowBox[{"RRLval", "[", 
              RowBox[{
               RowBox[{"m22", "/", "Msol"}], ",", 
               RowBox[{"m1", "/", "Msol"}]}], "]"}], 
             RowBox[{"-", "1"}]]}], ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"m22", ",", " ", 
          RowBox[{
           RowBox[{"1", "/", "5"}], "m1"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"m1", ",", "0.0001", ",", "1.4", ",", "0.01"}], "}"}]}], 
     "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{
