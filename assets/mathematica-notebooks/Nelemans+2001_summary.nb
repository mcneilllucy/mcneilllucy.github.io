Cell[CellGroupData[{
Cell["Mass transfer stability for finite temperature white dwarfs", "Title",
 CellChangeTimes->{{3.986514592894731*^9, 3.9865146147202597`*^9}, 
   3.986858330990699*^9},ExpressionUUID->"3ada1866-d039-4124-b62e-\
6c117addaa3d"],

Cell["Nelemans+2001 https://arxiv.org/pdf/astro-ph/0101123", "Text",
 CellChangeTimes->{{3.9865170189842157`*^9, 3.9865170698443108`*^9}, {
  3.9865171673546886`*^9, 3.986517170177164*^9}, {3.9865183698966208`*^9, 
  3.986518372574087*^9}, {3.986519035382503*^9, 3.986519035681445*^9}, {
  3.986847648455731*^9, 
  3.986847662729*^9}},ExpressionUUID->"4c08a42a-da52-4fdc-86db-1d55d27ad0e7"],

