Cell["\<\
alternatively, we can try according to what is written in Nelemans + 2001 \
anyway . Using Equation 6 in Nelemans + 2001 (log10 or log e ?)\
\>", "Text",
 CellChangeTimes->{{3.9868625800800753`*^9, 3.986862596871696*^9}, {
  3.986862965523728*^9, 
  3.986862965887766*^9}},ExpressionUUID->"df2889c1-707d-458b-9732-\
86398f8d8389"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rmin", "[", "q_", "]"}], ":=", 
  RowBox[{"0.04948", "\[Minus]", 
   RowBox[{"0.03815", " ", 
    RowBox[{"Log", "[", "q", "]"}]}], "+", 
   RowBox[{"0.04752", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"Log", "[", "q", "]"}], ")"}], "2"]}], "\[Minus]", 
   RowBox[{"0.006973", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"Log", "[", "q", "]"}], ")"}], "3"]}]}]}]], "Input",
 CellChangeTimes->{{3.9868639021485863`*^9, 3.986863905390414*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"422b0e5b-fa2d-4ce5-b41f-ad397a67e949"],

