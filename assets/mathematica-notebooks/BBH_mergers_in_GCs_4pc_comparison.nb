        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "4"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "3"}], ",", "2"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"AspectRatio", "->", 
      RowBox[{"2", "/", "3"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"LabelStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ")"}], ",", " ", 
        "Black"}], "}"}]}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
        "Style", "[", 
         "\"\<\!\(\*StyleBox[\"1\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\"-\
\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\" \
\",FontSlant->\"Italic\"]\)\!\(\*SubscriptBox[StyleBox[\"e\",FontSlant->\"\
Italic\"], \"eject\"]\)\>\"", "]"}], ",", 
        RowBox[{
        "Style", "[", "\"\<\!\(\*SubscriptBox[\(a\), \(eject\)]\) (AU)\>\"", 
         "]"}]}], "}"}]}], ",", 
     RowBox[{"BaseStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"FontSize", "\[Rule]", "20"}], "}"}]}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cp", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"PDF", "[", 
      RowBox[{"d", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "4"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "3"}], ",", "2"}], "}"}], ",", 
     RowBox[{"Contours", "->", "contours"}], ",", 
     RowBox[{"ContourShading", "->", "None"}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nonEmptyContours", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"splitUp", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coloredByContourPoints", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"nonEmptyContours", ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Black", ",", "Green", ",", "Orange", ",", "Red"}], "}"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sdh", ",", "cp", ",", "coloredByContourPoints"}], "}"}], ",", 
    RowBox[{"PlotRange", "->", "All"}]}], "]"}], ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.9862458973916388`*^9, 3.9862458973957157`*^9}, {
