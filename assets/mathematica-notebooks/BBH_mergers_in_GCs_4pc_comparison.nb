Notebook[{

Cell[CellGroupData[{
Cell["\<\
Stochastic globular cluster simulations of binary black hole dynamical \
interactions\
\>", "Title",
 CellChangeTimes->{{3.976924709206933*^9, 
  3.9769247363631783`*^9}},ExpressionUUID->"c5e25bfb-3a01-4c4a-8ad8-\
17624ecab96e"],

Cell[TextData[{
 "In this notebook we present an emulator for gravitational NBODY simulations \
of globular clusters, given a i) black hole population ",
 StyleBox["N",
  FontSlant->"Italic"],
 "(",
 StyleBox["m",
  FontSlant->"Italic"],
 ") and ii) initial conditions ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "h"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "227f36bf-277f-4af8-b3f1-e71d363fadbb"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "stars"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7f4dbef0-280a-46b0-9199-61a1d400ba14"],
 " for the NBODY simulation. \nWe make a comparison with state of the art \
globular cluster emulators by Kritos et al . https://arxiv.org/pdf/2210.10055\
\nFor reference, we will also compare with an NBODY simulation which we have \
at hand from DeVita et al. 2019\nhttps://arxiv.org/pdf/1903.07619"
}], "Text",
 CellChangeTimes->{{3.9769318060483294`*^9, 3.976931890267996*^9}, {
  3.977967547864204*^9, 3.9779675510575943`*^9}, {3.987101900010172*^9, 
  3.987101947097237*^9}, {3.987119499088317*^9, 
  3.9871196550666857`*^9}},ExpressionUUID->"1cb4fcf9-9bd6-438e-a5e2-\
903fa0603aff"],

