Cell["\<\
We make sure that the majority (f1 = 80%?) of BH in binaries are the most \
massive . But not all .\
\>", "Text",
 CellChangeTimes->{{3.976932172785811*^9, 3.9769321936590967`*^9}, {
  3.976932266864883*^9, 3.9769322695364723`*^9}, {3.9769327316237373`*^9, 
  3.9769327322597647`*^9}},ExpressionUUID->"d89d6c62-99dc-4e0a-b366-\
85cc890f9f92"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f1", " ", "=", " ", "0.8"}], ";"}]], "Input",
 CellChangeTimes->{{3.976932719082766*^9, 3.976932728171138*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"e79d9a3c-672b-4241-893c-62a1a32136b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mtemp", " ", "=", 
   RowBox[{"ReverseSort", "[", "m", "]"}]}], ";"}]], "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"82e311c7-ac0f-408c-bc21-59aee523bcc1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"min3", " ", "=", " ", 
   RowBox[{"mtemp", "[", 
    RowBox[{"[", 
     RowBox[{";;", 
      RowBox[{"Round", "[", 
       RowBox[{"f1", " ", "2", " ", "Nbin"}], "]"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.976932223940126*^9, 3.9769322639790363`*^9}, 
   3.976932298662785*^9, {3.9769327366379023`*^9, 3.976932736788948*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"6048118c-9bc0-47fb-aa6a-cfa1c8d6405d"],

Cell["To reorder, we delete the BH in binaries from mtemp", "Text",
 CellChangeTimes->{{3.976932332065696*^9, 
  3.976932351621347*^9}},ExpressionUUID->"e46b66c2-a0f8-4e7e-8454-\
e28144afa741"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mtemp", "[", 
    RowBox[{"[", 
     RowBox[{";;", 
      RowBox[{"Round", "[", 
       RowBox[{"f1", " ", "2", " ", "Nbin"}], "]"}]}], "]"}], "]"}], "=", 
   RowBox[{"-", "1"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8641795645981417`*^9, 3.8641795652121353`*^9}, {
   3.8642488037495527`*^9, 3.864248803845621*^9}, {3.8642489076537857`*^9, 
   3.8642489080403633`*^9}, {3.8696039316108437`*^9, 3.869603931663138*^9}, {
   3.869604006994438*^9, 3.869604007070409*^9}, 3.976932318248781*^9, 
   3.9769323799937487`*^9, {3.9769327442780743`*^9, 3.976932744362062*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"5f9a999d-931a-4087-9e86-0afa3834ed07"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mtemp2", " ", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"mtemp", ",", 
     RowBox[{
      RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.864174696171073*^9, 3.864174776069253*^9}, 
   3.8642650341374903`*^9},
 CellLabel->"In[49]:=",ExpressionUUID->"a387767c-0c55-4727-9563-ea594b97f9f9"],

Cell["\<\
mnew is our jumbled binary population, dominated by most massive\
\>", "Text",
 CellChangeTimes->{{3.976932419633543*^9, 
  3.976932424304393*^9}},ExpressionUUID->"4b6985db-37d1-4ea8-934a-\
8f79345932d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mnew", " ", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"min3", ",", 
     RowBox[{"RandomSample", "[", 
      RowBox[{"mtemp2", "[", 
       RowBox[{"[", "]"}], "]"}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.9769324102347403`*^9},
 CellLabel->"In[50]:=",ExpressionUUID->"efb54eaf-156b-4723-8582-e70830115506"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"minbinary0", " ", "=", 
   RowBox[{"mnew", "[", 
    RowBox[{"[", 
     RowBox[{";;", 
      RowBox[{"2", " ", "Nbin"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"minterlopers0", "  ", "=", " ", 
   RowBox[{"mnew", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", "Nbin"}], "+", "1"}], ";;"}], "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"29dc501f-516a-4da6-972a-37c10817c795"],

Cell["Now pair them up randomly", "Text",
 CellChangeTimes->{{3.97693279878119*^9, 
  3.976932807509289*^9}},ExpressionUUID->"2098da71-c6de-45c8-9b07-\
91255ea2302e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"testArrayOdd", ",", "testArrayEven"}], "}"}], "=", 
   RowBox[{
    RowBox[{"Partition", "[", 
     RowBox[{"minbinary0", ",", "2", ",", "2", ",", "1", ",", 
      RowBox[{"{", "}"}]}], "]"}], "~", "Flatten", "~", 
    RowBox[{"{", "2", "}"}]}]}], ";"}]], "Input",
 CellLabel->"In[53]:=",ExpressionUUID->"9a2cdd7d-3872-4ba1-aa68-55ac9877c335"],

Cell[BoxData[{
 RowBox[{"Clear", "@", "groupByPositions"}], "\n", 
 RowBox[{
  RowBox[{"groupByPositions", "[", 
   RowBox[{"list_", ",", "pred_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"trueList", "=", 
      RowBox[{"minbinary0", "[", 
       RowBox[{"[", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Range", "@", 
           RowBox[{"Length", "@", "list"}]}], ",", "pred"}], "]"}], "]"}], 
       "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"trueList", ",", 
      RowBox[{"Complement", "[", 
       RowBox[{"list", ",", "trueList"}], "]"}]}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"testArrayOdd", ",", "testArrayEven"}], "}"}], "=", 
   RowBox[{"groupByPositions", "[", 
    RowBox[{"minbinary0", ",", "OddQ"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"06ad30e1-6931-43ff-ae12-be8792ae1762"],

Cell["\<\
We arrange the ones in binaries so that more massive is at an odd index. \
\>", "Text",
 CellChangeTimes->{{3.864082860507756*^9, 3.864082875724843*^9}, {
  3.864265126690928*^9, 3.864265137769198*^9}, {3.976932841946347*^9, 
  3.976932843362582*^9}},ExpressionUUID->"e87843b8-dfc0-414d-a553-\
96ed1ad0199a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"diffarray", " ", "=", " ", 
   RowBox[{"testArrayEven", "-", "testArrayOdd"}]}], ";"}]], "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"8807fa16-1267-4804-ac57-d603cd7dab80"],

Cell[BoxData[
 RowBox[{
  RowBox[{"m1big", " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Pick", "[", 
      RowBox[{"testArrayEven", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", ">", "0"}], "&"}], "/@", "diffarray"}]}], "]"}], ",", 
     RowBox[{"Pick", "[", 
      RowBox[{"testArrayOdd", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "<", "0"}], "&"}], "/@", "diffarray"}]}], "]"}]}], " ", 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[58]:=",ExpressionUUID->"462120ee-b488-4e28-93c2-f007a9ec42d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"m2small", " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Pick", "[", 
      RowBox[{"testArrayEven", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "<", "0"}], "&"}], "/@", "diffarray"}]}], "]"}], ",", 
     RowBox[{"Pick", "[", 
      RowBox[{"testArrayOdd", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", ">", "0"}], "&"}], "/@", "diffarray"}]}], "]"}]}], " ", 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[59]:=",ExpressionUUID->"99752b7e-1db7-4449-8683-ee60c12ec4e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mbin", " ", "=", 
  RowBox[{"m1big", " ", "+", "m2small"}]}]], "Input",
 CellChangeTimes->{3.976932933190342*^9},
 CellLabel->"In[60]:=",ExpressionUUID->"c51b6124-bd54-4af2-bf0e-65f3f86e4603"],

