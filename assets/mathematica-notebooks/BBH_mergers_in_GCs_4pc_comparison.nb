Cell[BoxData[{
 RowBox[{
  RowBox[{"cPad", "=", 
   RowBox[{"PadLeft", "[", 
    RowBox[{"c", ",", 
     RowBox[{
      RowBox[{"Length", "@", "c"}], "+", "1"}], ",", "1"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"cPad", "=", 
   RowBox[{"PadRight", "[", 
    RowBox[{"cPad", ",", 
     RowBox[{
      RowBox[{"Length", "@", "cPad"}], "+", "1"}], ",", "0"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"quantileBounds", "=", 
   RowBox[{"Partition", "[", 
    RowBox[{"cPad", ",", "2", ",", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"splitUp", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"data", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Last", "[", "i", "]"}], "<", 
          RowBox[{"PDF", "[", 
           RowBox[{"d", ",", "#"}], "]"}], "<=", 
          RowBox[{"First", "[", "i", "]"}]}], "&"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "quantileBounds"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sdh", "=", 
   RowBox[{"SmoothDensityHistogram", "[", 
    RowBox[{"data", ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
