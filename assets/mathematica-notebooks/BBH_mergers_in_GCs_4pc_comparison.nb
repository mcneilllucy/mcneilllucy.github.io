Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"data", " ", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Log10", "[", 
        RowBox[{"1", "-", "eejmergesto"}], "]"}], ",", 
       RowBox[{"Log10", "[", 
        RowBox[{"aejmergesto", "/", 
         RowBox[{"(", 
          RowBox[{"1.496", " ", 
           SuperscriptBox["10", "11"]}], ")"}]}], "]"}]}], "}"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Calculate", " ", "a", " ", "nonparametric", " ", "density", " ", 
    "estimate"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"d", "=", 
    RowBox[{"SmoothKernelDistribution", "[", "data", "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Evaluate", " ", "the", " ", "estimated", " ", "density", " ", "function", 
    " ", "over", " ", "a", " ", "grid", " ", "of", " ", "points", " ", "and", 
    " ", "sort", " ", "by", " ", "the", " ", "density", " ", "values", " ", 
    "from", " ", "high", " ", "to", " ", "low"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pdf", "=", 
    RowBox[{"Reverse", "[", 
     RowBox[{"Sort", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"PDF", "[", 
          RowBox[{"d", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "3"}], ",", "3", ",", "0.05"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", 
           RowBox[{"-", "3"}], ",", "3", ",", "0.05"}], "}"}]}], "]"}], "]"}],
       "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Create", " ", "a", " ", "table", " ", "of", " ", "cumulative", " ", "pdf",
     " ", "values", " ", "that", " ", "correspond", " ", "to", " ", "the", 
    " ", "volumes", " ", "of", " ", "interest"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cdf", "=", 
   RowBox[{
    RowBox[{"Accumulate", "[", "pdf", "]"}], "/", 
    RowBox[{"Total", "[", "pdf", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"contours", "=", 
    RowBox[{"pdf", "[", 
     RowBox[{"[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"FirstPosition", "[", 
          RowBox[{"cdf", ",", 
           RowBox[{"p_", "/;", 
            RowBox[{"p", ">=", "alpha"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"alpha", ",", 
           RowBox[{"{", 
            RowBox[{"0.68", ",", "0.95", ",", "0.99"}], "}"}]}], "}"}]}], 
        "]"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"c", "=", "contours"}], ";"}]}], "Input",
 CellChangeTimes->{{3.986245883271117*^9, 3.9862458832744904`*^9}, {
   3.9862459385954733`*^9, 3.986245954198287*^9}, {3.986246040380907*^9, 
   3.9862460561111526`*^9}, 3.986956699239373*^9, {3.986957568273987*^9, 
