Cell[BoxData[{
 RowBox[{
  RowBox[{"NBHi", "=", "140"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"incluster", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"1", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "NBHi"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mtemp", " ", "=", " ", 
   RowBox[{
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"ExponentialDistribution", "[", "0.7", "]"}], ",", "NBHi"}], 
     "]"}], "+", "10"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mtemp", " ", "=", " ", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{
     RowBox[{"GammaDistribution", "[", 
      RowBox[{"8", ",", "1.5"}], "]"}], ",", "NBHi"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", " ", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"mtemp", " ", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"8", "<", "#", "<", "40"}], "&"}], "/@", "mtemp"}]}], " ", 
    "]"}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{"NBH", " ", "=", " ", 
