Cell[TextData[{
 "Note that the black hole subcluster has a much smaller half mass radius. We \
take this directly from the NBODY simulation, which is not at time zero but \
at around 2 Gyr after the cluster has properly collapsed. \nThis comes from \
Equation 30 in Lee https://arxiv.org/pdf/astro-ph/9409073\nIt is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", 
     RowBox[{"h", ",", "BH"}]], "=", "  ", 
    RowBox[{"0.02", " ", 
     FractionBox["8", "\[Xi]min"], 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["MBHav", "10"], ")"}], "2"], 
     FractionBox["MBH", 
      RowBox[{"1000", " ", "MBHav"}]], 
     FractionBox["0.64", "mav"], 
     FractionBox[
      SuperscriptBox["10", "6"], "Mtot"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cd30d27f-af88-4194-a0b0-0d8fe63aa96e"],
 "\nwhere\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Xi]", "min"], "="}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cf8b4aee-c020-4e8f-81c0-0d2ab989bb52"],
 " ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["mbar", "3"], 
     SuperscriptBox["Mbar", "2"], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["27", "4"], 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{"3", " ", "Mbar"}], 
          RowBox[{"2", " ", "mbar"}]]}], ")"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{
           FractionBox["5", "2"], "Mbar"}]}], ")"}], 
        RowBox[{"-", "3"}]]}], ")"}]}], ")"}], 
   RowBox[{"1", "/", "3"}]]],
  CellChangeTimes->{3.987102466069524*^9, 3.987102633526347*^9},
  ExpressionUUID->"5d81bb0a-a410-4ce6-a204-d03d4f2ef021"],
 "\nand\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["m", "bar"], " ", "=", 
    FractionBox[
     RowBox[{" ", 
      SubscriptBox["M", 
       RowBox[{"BH", ",", "av"}]]}], 
     SubscriptBox["m", "av"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6018fed1-40fc-47f4-b541-71391285a4f7"],
 "\nand\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", "bar"], " ", "=", 
    FractionBox[
     RowBox[{" ", 
      SubscriptBox["M", "BH"]}], 
     SubscriptBox["M", "tot"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ed0dadbf-2693-4d27-9a45-f991c68bf6be"]
}], "Text",
 CellChangeTimes->{{3.976934373843523*^9, 3.9769343914023857`*^9}, {
  3.987101967594997*^9, 3.9871019946264057`*^9}, {3.987102081385641*^9, 
