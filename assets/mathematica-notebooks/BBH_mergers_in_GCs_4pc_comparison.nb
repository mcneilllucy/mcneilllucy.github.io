371f0461f97a"],

Cell[TextData[{
 "From the can200k simulation, there are 109 black holes, ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["M", 
      RowBox[{"BH", ",", "av"}]], "=", "9.75"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "20088353-491f-4782-9533-b5eb807c48c0"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", 
     RowBox[{"h", ",", " ", "BH"}]], " ", "=", " ", 
    RowBox[{"0.6", " ", "pc"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "90f9da9a-bc77-4785-893f-53248b3bf5ad"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "av"], TraditionalForm]],ExpressionUUID->
  "28499d8c-3fc1-4fba-b8df-cf46c21d26cb"],
 " = 0.4, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "tot"], TraditionalForm]],ExpressionUUID->
  "2c2199f8-4f02-4d09-b531-772287254661"],
 "= 95,000. Then "
}], "Text",
