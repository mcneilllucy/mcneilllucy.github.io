\>", "Text",
 CellChangeTimes->{{3.976924851102405*^9, 3.9769248681212587`*^9}, {
  3.987104495668148*^9, 3.9871044960854187`*^9}, {3.987104529148944*^9, 
  3.987104532643086*^9}},ExpressionUUID->"c341cf36-b740-4b01-b1bc-\
084cc9c9a50b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dista", "[", "x_", "]"}], "=", 
    RowBox[{"ProbabilityDistribution", "[", 
     RowBox[{
      RowBox[{
       FractionBox["5", "2"], " ", 
       SuperscriptBox["x", 
        RowBox[{"3", "/", "2"}]]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.976924913303851*^9, 3.9769249257011843`*^9}, {
   3.976940659886218*^9, 3.976940667990176*^9}, {3.9778855498697233`*^9, 
   3.97788558868139*^9}, {3.977885674601644*^9, 3.977885693869905*^9}, {
   3.977888260686974*^9, 3.9778882850542088`*^9}, 3.977940157815593*^9, {
   3.9841900312945623`*^9, 3.9841900336253147`*^9}, 3.984190193919541*^9, {
   3.984192937232826*^9, 3.984192947297635*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"65c08f2e-7729-4bc9-bd70-8633b6a7929a"],

Cell["\<\
Eccentricities (from Stone and Leigh, around middle of page 5)\
\>", "Text",
 CellChangeTimes->{{3.977940168886763*^9, 3.977940175214754*^9}, {
  3.978474308116336*^9, 3.978474313985682*^9}, {3.978474428820696*^9, 
  3.978474436345469*^9}},ExpressionUUID->"a3880055-65a9-4237-8ea0-\
ff24473cccf2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"diste", "[", "x_", "]"}], "=", 
   RowBox[{"ProbabilityDistribution", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{"4", "+", "\[Pi]"}], "8"], ")"}], 
       RowBox[{"-", "1"}]], " ", 
      FractionBox[
       RowBox[{"x", 
        RowBox[{"(", 
         RowBox[{"1", "+", "x"}], ")"}]}], 
       RowBox[{"2", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["x", "2"]}], ")"}], 
         RowBox[{"1", "/", "2"}]]}]]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"distetherm", "[", "x_", "]"}], "=", 
   RowBox[{"ProbabilityDistribution", "[", 
    RowBox[{
     RowBox[{"2", "x"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.9779401648840227`*^9},
 CellLabel->"In[33]:=",ExpressionUUID->"a9a3b008-db93-4ed8-b1c4-f709de73c4c8"],

Cell["\<\
We take the probability that the interloper m3 component is NOT swapped out \
from Ginat and Perets 2019:\
\>", "Text",
 CellChangeTimes->{{3.976924979567293*^9, 3.976925001221973*^9}, {
  3.9769251581049223`*^9, 
  3.976925168108061*^9}},ExpressionUUID->"513ea315-f68a-48c1-beb2-\
a9ac865ba8fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Pswap", "[", 
    RowBox[{"m11_", ",", "m22_", ",", "m33_"}], "]"}], "=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["m11", "4"], 
      SuperscriptBox["m22", "4"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"m11", "+", "m22"}], ")"}], 
       RowBox[{"5", "/", "2"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["m11", "4"], 
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            SuperscriptBox["m33", "4"], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"m33", "+", "m11"}], ")"}], 
             RowBox[{"5", "/", "2"}]]], "+", 
           FractionBox[
            SuperscriptBox["m22", "4"], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"m11", "+", "m22"}], ")"}], 
             RowBox[{"5", "/", "2"}]]]}], ")"}]}], "+", 
        FractionBox[
         RowBox[{
          SuperscriptBox["m33", "4"], 
          SuperscriptBox["m22", "4"]}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"m33", "+", "m22"}], ")"}], 
          RowBox[{"5", "/", "2"}]]]}], ")"}]}], ")"}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.976925006685356*^9, 3.976925010184478*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"5d416e03-c7c7-4725-acac-3c7a4fce44c9"],

Cell["\<\
The hardening factor if given by equation 11 in Kritos + 2024. Note equal \
mass case is 0.78.\
\>", "Text",
 CellChangeTimes->{{3.9772821737642517`*^9, 
  3.977282256724505*^9}},ExpressionUUID->"a357b56c-b80e-4872-a4bb-\
8f463f203526"]
}, Open  ]]
}, Open  ]],

