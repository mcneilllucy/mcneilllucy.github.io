Cell[CellGroupData[{

Cell["initial binary separations and eccentricities", "Subsection",
 CellChangeTimes->{{3.976932488985094*^9, 3.976932507654306*^9}, {
  3.977877089341167*^9, 
  3.9778770930380793`*^9}},ExpressionUUID->"a686aa50-8b92-46f4-a6f4-\
272e823872c8"],

Cell["\<\
For the initial separations, we draw from a log Uniform distribution with a \
maximum of the hard - soft boundary like Morscher + 2015\
\>", "Text",
 CellChangeTimes->{{3.976931135883616*^9, 3.9769311685135813`*^9}, 
   3.9769312328933*^9},ExpressionUUID->"dee62ab9-7431-42c1-936c-7740ef559588"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ahard", " ", "=", " ", 
   RowBox[{"G", 
    RowBox[{"(", 
     RowBox[{"m1big", " ", "+", "m2small"}], ")"}], 
    RowBox[{"Msunkg", "/", 
     SuperscriptBox["v", "2"]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.97693347720667*^9, 3.9769334775260563`*^9}, {
  3.9769337779044724`*^9, 3.976933783578741*^9}},
 CellLabel->"In[66]:=",ExpressionUUID->"566ee155-4f41-40b7-ac1f-49370d703e4b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"amin", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"50", " ", 
      RowBox[{"(", 
       RowBox[{"Rsun", "+", "Rsun"}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "ahard", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.976933806420257*^9, 3.976933810037095*^9}, 
   3.976935219922554*^9, 3.9769408985703087`*^9, {3.9769409323785152`*^9, 
   3.9769409326023703`*^9}, {3.976942426986116*^9, 3.976942427577298*^9}, 
   3.976943183357678*^9},
 CellLabel->"In[67]:=",ExpressionUUID->"dcbee696-2d0f-4858-b6de-4910686820ac"],

Cell["Initial eccentricities drawn from a thermal distribution.", "Text",
 CellChangeTimes->{{3.977874500762402*^9, 
  3.977874536796934*^9}},ExpressionUUID->"aef4b8ac-ef6d-4d0f-ade0-\
f65975812e3a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"earrbin", "=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", "Nbin"}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[68]:=",ExpressionUUID->"6e0b2447-4ddb-449e-a747-a9cf241da477"],

Cell[BoxData[
 RowBox[{
  RowBox[{"aarrbinlog", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"RandomVariate", "[", 
      RowBox[{"UniformDistribution", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Log", "[", "amin", "]"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"Log", "[", "ahard", "]"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "}"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "ahard", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.976933838039812*^9, 3.976933846417288*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"c2c4160c-bc54-4f7d-8e9e-d72d44049f4c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"aarrbin2", "=", 
   RowBox[{"Exp", "[", "aarrbinlog", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aedata", " ", "=", 
   RowBox[{"Transpose", "@", 
    RowBox[{"{", 
     RowBox[{"aarrbin2", ",", "earrbin"}], "}"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{3.976933884356523*^9},
 CellLabel->"In[70]:=",ExpressionUUID->"7ef3813b-721b-4510-a221-3ef1e349353e"],

