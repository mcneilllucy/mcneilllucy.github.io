   SuperscriptBox["fGW", 
    RowBox[{"8", "/", "3"}]]]}]], "Output",
 CellChangeTimes->{3.9937737138032207`*^9},
 CellLabel->
  "Out[144]=",ExpressionUUID->"2a6b2066-bf5a-47c2-914b-1f6006ef2c6e"]
}, Open  ]],

Cell[TextData[{
 "We want to work with the orbital period instead, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "GW"], " ", "=", " ", 
    FractionBox["2", 
     SubscriptBox["P", "orb"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8cf953c8-5120-4a49-a2da-9ff373d93933"],
 ", so that the distribution is given by"
}], "Text",
 CellChangeTimes->{{3.9937733892844687`*^9, 
  3.993773438023932*^9}},ExpressionUUID->"d1bbef1e-dcb3-4511-bc6b-\
0cd68631fe1e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"periodIa", "=", 
   RowBox[{"ProbabilityDistribution", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"NIa", "[", "fGW", "]"}]}], 
      SuperscriptBox["fGW", 
       RowBox[{"8", "/", "3"}]], 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["2", 
         RowBox[{"z", " ", "0.001", " ", "60", " ", "60"}]], ")"}], 
       RowBox[{
        RowBox[{"-", "8"}], "/", "3"}]]}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "fGWlow", ",", "Infinity"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PeriodIa", "[", "P_", "]"}], ":=", " ", 
   RowBox[{"PDF", "[", 
    RowBox[{"periodIa", ",", "P"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.965185314250348*^9, 3.9651853168813667`*^9}, {
   3.992899301603174*^9, 3.992899357099737*^9}, {3.992899554083395*^9, 
