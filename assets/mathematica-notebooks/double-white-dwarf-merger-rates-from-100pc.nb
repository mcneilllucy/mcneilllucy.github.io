Cell["\<\
We may want to roughly compare with the chirp mass distribution of CO+CO \
binaries in fig 4 here https://arxiv.org/html/2607.09980v1\
\>", "Text",
 CellChangeTimes->{{3.993770142916814*^9, 3.99377016086224*^9}, {
  3.993770242199431*^9, 3.99377024865441*^9}, {3.993770292521121*^9, 
  3.993770296523252*^9}},ExpressionUUID->"ed7fa7b8-356d-4188-87cd-\
212597edd70d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mchirpav", " ", "=", " ", 
  RowBox[{"Mean", "[", 
   RowBox[{"Mchirpf", "[", 
    RowBox[{"draws", ",", "draws2"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9937701673247433`*^9, 3.993770168647689*^9}, {
  3.99377166819249*^9, 3.993771670449966*^9}},
 CellLabel->
  "In[113]:=",ExpressionUUID->"09db8d03-3f0a-429a-ad5e-947142f509db"],

Cell[BoxData["0.5045176854013118`"], "Output",
 CellChangeTimes->{3.993770168972858*^9, 3.993771671038567*^9},
 CellLabel->
  "Out[113]=",ExpressionUUID->"6a9ac117-aa12-4c76-87e6-0296585796c2"]
}, Open  ]],

Cell[TextData[{
 "To proceed (and make the calculation later easier), it should be reasonable \
to say that the chirp mass of merging binaries is \"sharply peaked at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.5", 
    SubscriptBox["M", 
     RowBox[{"\[Sun]", " "}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5d9b1625-9df3-4c1e-bfe9-859cc2884b25"],
 "\""
}], "Text",
 CellChangeTimes->{{3.993770451070797*^9, 
  3.993770503929432*^9}},ExpressionUUID->"01645098-48b5-44dc-9007-\
7d94c8db2fa0"],

Cell["\<\
But we should note that the chirp mass of a Chandrasekhar limit merger is \
slightly larger, at\
\>", "Text",
 CellChangeTimes->{{3.993770592140974*^9, 
  3.993770624611971*^9}},ExpressionUUID->"778a3be2-c9ad-49b8-8005-\
798f56c35afe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Mchirpf", "[", 
  RowBox[{"0.7", ",", "0.7"}], "]"}]], "Input",
 CellChangeTimes->{{3.9929029851726513`*^9, 3.992902997118256*^9}},
 CellLabel->
  "In[102]:=",ExpressionUUID->"2ec1ec9e-5dcc-4115-ad5e-8e822c33092f"],

Cell[BoxData["0.6093853943072869`"], "Output",
 CellChangeTimes->{{3.992902989271779*^9, 3.9929029976054487`*^9}, 
   3.99290351372924*^9, 3.993690571820054*^9, 3.99369060750311*^9, 
   3.993690638468197*^9, 3.993690746797065*^9, 3.9936915134870453`*^9, {
   3.99369156102555*^9, 3.993691577768614*^9}, 3.993692028212175*^9, 
   3.9936922499352713`*^9, 3.993692350718256*^9, 3.993693152145063*^9, 
   3.993693207624278*^9, 3.993693254849177*^9, 3.993693350358983*^9, 
   3.993768309920122*^9, 3.99377061501227*^9},
 CellLabel->
  "Out[102]=",ExpressionUUID->"e1faeed3-144c-421a-8234-a5bcdae03ea3"]
