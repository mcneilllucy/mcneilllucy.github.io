Notebook[{

Cell[CellGroupData[{
Cell["\<\
1. Motivation: the population of merger product candidates in Gaia\
\[CloseCurlyQuote]s complete 100 pc sample\
\>", "Title",
 CellChangeTimes->{{3.99376639283156*^9, 3.993766395201311*^9}, {
  3.99376646706992*^9, 3.9937664808328943`*^9}, {3.993766544343313*^9, 
  3.993766552035275*^9}, {3.993774127330161*^9, 
  3.9937741426873083`*^9}},ExpressionUUID->"53f53534-d0df-4aae-88e1-\
03f74ca0d045"],

Cell["\<\
Here we provide the main motivations for our study. Motivations relate to the \
properties of white dwarfs in the complete volume limited 100 pc sample. Our \
main motivation is the Ultra-massive white dwarfs which have been identified \
as candidate double white dwarf merger products.\
\>", "Text",
 CellChangeTimes->{{3.993766491698813*^9, 3.993766504833908*^9}, {
  3.993769086308429*^9, 
  3.993769187192543*^9}},ExpressionUUID->"4c470841-2f75-474a-a030-\
1fb5ed7d9f2a"],

Cell[CellGroupData[{

Cell["\<\
a. The mass distribution of white dwarfs in the 100 pc sample\
\>", "Subsection",
 CellChangeTimes->{{3.993767493026696*^9, 3.9937675217497597`*^9}, {
  3.9937690515173197`*^9, 
  3.993769051877759*^9}},ExpressionUUID->"12b1bf37-42f0-484c-8130-\
