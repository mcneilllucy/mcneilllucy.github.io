  3.993771433403955*^9}},ExpressionUUID->"e8722dad-c09e-4ef4-891f-\
1e84ca147ff2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"v100pc", " ", "=", " ", 
   RowBox[{
    FractionBox["4", "3"], "\[Pi]", " ", 
    SuperscriptBox["VLr", "3"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.993771397619368*^9, 3.99377139847281*^9}, {
  3.993771435700035*^9, 3.993771442246027*^9}},
 CellLabel->
  "In[110]:=",ExpressionUUID->"af3df94b-a4be-444d-83b9-af3c20350d45"],

Cell["\<\
While the volume of the Milky Way will have a diameter of 30 kpc and scale \
height 1 kpc (note I found some other paper which uses a smaller scale \
height):\
\>", "Text",
 CellChangeTimes->{{3.922735532158845*^9, 3.922735555490395*^9}, {
  3.922735630026373*^9, 3.9227356401139183`*^9}, {3.993771475397551*^9, 
  3.993771506041731*^9}},ExpressionUUID->"67a6c984-7cd5-40d5-a268-\
839832a72eea"],

