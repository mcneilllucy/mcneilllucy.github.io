 CellChangeTimes->{
  3.993775788869822*^9},ExpressionUUID->"11ea1673-7e1d-4c38-9c2a-\
a063a7804cb5"],

Cell["this is", "Text",
 CellChangeTimes->{{3.993771839383801*^9, 
  3.9937718697232523`*^9}},ExpressionUUID->"46a38161-9f64-4432-b34f-\
2a6d551f5bd0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N100pcUltra", " ", "=", " ", 
  RowBox[{
   FractionBox["RMWlow", 
    RowBox[{"\[Pi]", " ", 
     SuperscriptBox["10", "7"]}]], "vobs", " ", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"dfdt", "[", 
       RowBox[{"fGW", ",", "mchirpav"}], "]"}], 
      RowBox[{"-", "1"}]], ",", 
     RowBox[{"{", 
      RowBox[{"fGW", ",", "fGWlow", ",", "fGWhigh"}], "}"}]}], 
