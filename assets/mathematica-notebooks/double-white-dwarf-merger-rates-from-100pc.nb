Cell[TextData[{
 "Now we only select our predicted sums in the range of 0.9 < ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "\[Sun]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "918e6bfe-8371-4832-a105-24740b9de950"],
 "< 1.4:"
}], "Text",
 CellChangeTimes->{{3.9937688237232847`*^9, 
  3.9937688955039797`*^9}},ExpressionUUID->"453d54d4-36e7-43fe-9ecb-\
559b3b1d3735"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Sumcut", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{"Masssum", ",", 
     RowBox[{
      RowBox[{"#", ">", "0.9"}], "&"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Sumcut2", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{"Sumcut", ",", 
     RowBox[{
      RowBox[{"#", "<", " ", "1.4"}], "&"}]}], "]"}]}], ";"}]}], "Input",
