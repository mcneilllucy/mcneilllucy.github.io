}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Calculating the total number of short period CO+CO binaries (i.e. the \
progenitors of Ultra-massive WD merger products) in the 100 pc sample\
\>", "Subsection",
 CellChangeTimes->{{3.993770664327108*^9, 3.9937706765652847`*^9}, {
  3.993770761679531*^9, 3.9937708061754293`*^9}, {3.993772046692415*^9, 
  3.993772055895378*^9}},ExpressionUUID->"f8a3f4fd-527a-4ff1-bd0a-\
c062fd9081f9"],

Cell["\<\
We first define the rate of decay for a given binary due to the emission of \
gravitational waves\
\>", "Text",
 CellChangeTimes->{{3.9937708474788923`*^9, 
  3.993770872534088*^9}},ExpressionUUID->"3774222a-c425-4782-b21d-\
d8ecadf4b11d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"dfdt", "[", 
   RowBox[{"fGW_", ",", "mchirp_"}], "]"}], "=", 
  FractionBox[
   RowBox[{"96", " ", 
    SuperscriptBox["\[Pi]", 
     RowBox[{"8", "/", "3"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"6.67", " ", 
       SuperscriptBox["10", 
        RowBox[{"-", "8"}]]}], ")"}], 
     RowBox[{"5", "/", "3"}]], 
    SuperscriptBox[
     RowBox[{"(", "fGW", ")"}], 
     RowBox[{"11", "/", "3"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"mchirp", " ", "2", " ", 
       SuperscriptBox["10", "33"]}], ")"}], 
     RowBox[{"5", "/", "3"}]]}], 
   RowBox[{"5", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"3", " ", 
       SuperscriptBox["10", "10"]}], ")"}], "5"]}]]}]], "Input",
 CellLabel->
  "In[103]:=",ExpressionUUID->"4a91cbd8-437e-4bf5-b56a-91907ff701c0"],

Cell[BoxData[
 RowBox[{"5.825783371450022`*^-7", " ", 
  SuperscriptBox["fGW", 
   RowBox[{"11", "/", "3"}]], " ", 
  SuperscriptBox["mchirp", 
   RowBox[{"5", "/", "3"}]]}]], "Output",
 CellChangeTimes->{3.993770877937929*^9},
 CellLabel->
  "Out[103]=",ExpressionUUID->"3e90565f-7f15-4c4d-96d1-608ba7d62ba5"]
}, Open  ]],

Cell["\<\
The following calculation is only applicable for binaries which will merge in \
<< Hubble time, so we solve for the critical orbital period where binaries \
will or won\[CloseCurlyQuote]t merge.\
\>", "Text",
 CellChangeTimes->{{3.993770904430521*^9, 3.993770917822996*^9}, {
  3.9937709488881493`*^9, 
  3.993771026314391*^9}},ExpressionUUID->"eb685a8c-73bf-4b25-a949-\
df8e4fc6fe38"],

Cell["\<\
First define a \"steady state\" timescale to be 1 Gyr (in seconds)\
\>", "Text",
 CellChangeTimes->{{3.993771072445958*^9, 
  3.993771096739264*^9}},ExpressionUUID->"82165557-5b6f-40ce-bfbd-\
5404e7375500"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Tsteady", " ", "=", 
   RowBox[{"1", " ", 
    SuperscriptBox["10", "9"], "\[Pi]", " ", 
    SuperscriptBox["10", "7"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.92274597434627*^9, 3.922745986561998*^9}, {
   3.92274793991639*^9, 3.92274794021846*^9}, 3.922748232837571*^9},
 CellLabel->
  "In[104]:=",ExpressionUUID->"dbaadf98-7b30-49c4-9644-776faf25b1f8"],

Cell["Then we calculate the merger timescale", "Text",
 CellChangeTimes->{{3.9937711078543253`*^9, 
  3.9937711188768578`*^9}},ExpressionUUID->"b748044d-9f26-4dc2-adae-\
6d244f6f2d53"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"dfdt", "[", 
     RowBox[{"fGW", ",", "0.5"}], "]"}], 
    RowBox[{"-", "1"}]], ",", 
   RowBox[{"{", 
    RowBox[{"fGW", ",", "fmin", ",", "\[Infinity]"}], "}"}]}], "]"}]], "Input",\

 CellChangeTimes->{3.9937711788487787`*^9},
 CellLabel->
  "In[106]:=",ExpressionUUID->"d956ff57-7236-458c-9783-67c00924a352"],

Cell[BoxData[
 TemplateBox[{
   FractionBox["2.043589184607502`*^6", 
    SuperscriptBox["fmin", 
     RowBox[{"8", "/", "3"}]]], 
   RowBox[{
     RowBox[{
       RowBox[{"Im", "[", "fmin", "]"}], "\[NotEqual]", "0"}], "||", 
     RowBox[{
       RowBox[{"Re", "[", "fmin", "]"}], ">", "0"}]}]},
  "ConditionalExpression"]], "Output",
 CellChangeTimes->{3.993771181216111*^9},
 CellLabel->
  "Out[106]=",ExpressionUUID->"6abdf467-bffd-4acd-8c82-f698ea73c53a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fmin", "/.", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      FractionBox["2.043589184607502`*^6", 
       SuperscriptBox["fmin", 
        RowBox[{"8", "/", "3"}]]], "==", "Tsteady"}], ",", "fmin"}], "]"}], 
   "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9227458736686153`*^9, 3.922745907768845*^9}, {
   3.922745962249546*^9, 3.922746025921749*^9}, 3.922746070441189*^9, {
   3.922746179846736*^9, 3.9227461842910633`*^9}, {3.922747891535212*^9, 
   3.922747902642803*^9}, {3.922750135423411*^9, 3.922750155938065*^9}, 
   3.9929030275514097`*^9, 3.993771188226254*^9},
 CellLabel->
  "In[107]:=",ExpressionUUID->"bc217d59-f40f-4ff9-9aa8-12d57077dac6"],

Cell[BoxData["0.00015134441398294879`"], "Output",
 CellChangeTimes->{
  3.922746029103323*^9, 3.922746071196919*^9, 3.922746184930605*^9, {
   3.922747893545226*^9, 3.922747903059949*^9}, 3.922747944739916*^9, 
   3.922748200803142*^9, 3.922748239491479*^9, 3.922749180300992*^9, {
   3.922750147717267*^9, 3.922750168755117*^9}, 3.9515114510867767`*^9, {
   3.954290584239998*^9, 3.954290630355783*^9}, 3.954290665237459*^9, 
   3.954290747555928*^9, 3.958953124524448*^9, 3.96214546752885*^9, 
   3.963522237077777*^9, 3.964583763726568*^9, 3.965185493583864*^9, 
   3.965185738532864*^9, 3.965185777431078*^9, 3.9651868010260687`*^9, 
   3.965186831942347*^9, 3.992898766757411*^9, 3.9928989270424023`*^9, {
   3.992899020446039*^9, 3.992899070880229*^9}, 3.992899516365417*^9, 
   3.99289958112729*^9, {3.9928997175990973`*^9, 3.9928997377859297`*^9}, 
   3.99289980586053*^9, 3.99289989074118*^9, 3.992903028260844*^9, 
   3.9929035139190474`*^9, 3.993690572600666*^9, 3.9936906076984987`*^9, 
   3.9936906386670933`*^9, 3.993690746994714*^9, 3.993691513703291*^9, {
   3.993691561208767*^9, 3.9936915779582167`*^9}, 3.993692028398357*^9, 
   3.993692250119018*^9, 3.993692350908657*^9, 3.9936931523322353`*^9, 
   3.9936932081221237`*^9, 3.993693255309491*^9, 3.993693350550786*^9, 
   3.993768310518632*^9, 3.993771188868676*^9},
 CellLabel->
  "Out[107]=",ExpressionUUID->"118989b3-4465-492c-af86-84cbeb3b2811"]
}, Open  ]],

Cell["In hours, this is 3.7 hours", "Text",
 CellChangeTimes->{{3.993772078142254*^9, 3.993772080837569*^9}, {
  3.9937721110750628`*^9, 
  3.993772116508621*^9}},ExpressionUUID->"b91612d2-a2e2-426a-903b-\
0669c5c3924f"],

Cell[TextData[{
 "So for the minimum frequency a 0.5",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "\[Sun]"], TraditionalForm]],ExpressionUUID->
  "aedd956d-cc3a-40b5-9167-98d43d6f53ce"],
 " chirp mass binary needs at formation, to reach mass transfer in 1 Gyr (so \
that the steady state assumption is justified) is 0.151 mHz . We will limit \
our calculation to a minimum frequency of 0.000151344 Hz, and take the \
maximum to be ~ few mHz.. but note that the higher frequency is not so \
sensitive."
}], "Text",
 CellChangeTimes->{{3.993771202182036*^9, 
  3.993771333389505*^9}},ExpressionUUID->"c4220fad-3e90-4482-a1b3-\
77cb767e958e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fGWlow", "=", "0.00015134441398294879"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fGWhigh", "=", "0.003"}], ";"}]}], "Input",
 CellChangeTimes->{{3.922734841601613*^9, 3.922734852462199*^9}, {
   3.922735213892989*^9, 3.92273521695611*^9}, {3.922740135307667*^9, 
   3.922740141227717*^9}, {3.9227481801412983`*^9, 3.922748187396282*^9}, {
   3.9515261212391853`*^9, 3.951526121508045*^9}, 3.951526165333868*^9, {
   3.951526197314507*^9, 3.951526206001359*^9}, {3.992898799725091*^9, 
   3.992898803328513*^9}, {3.993692016855729*^9, 3.99369202217474*^9}, {
   3.9937713450665493`*^9, 3.993771348882567*^9}},
 CellLabel->
  "In[108]:=",ExpressionUUID->"1da87e31-b1e6-4fab-b219-8c10e771222d"],

Cell["\<\
Considering that CO + CO binaries are likely to be found by spectroscopy \
rather than eclipses (is this OK?), unlike McNeill and Hirai 2025 we do not \
include the eclipse probability in the selection effect function.\
\>", "Text",
 CellChangeTimes->{{3.993771581736354*^9, 
  3.993771651064576*^9}},ExpressionUUID->"fcc9b441-0d1a-4ab6-8be8-\
95f9cbca0b4e"],

Cell["\<\
Taking the rate of orbital decay due to GW emission, assuming some constant \
merger rate we can predict the total number of short period binaries we \
expect in 100 pc. Taking the Type Ia rate to be 1 per year (0.01 / year)\
\>", "Text",
 CellChangeTimes->{{3.99377173267314*^9, 3.993771823281145*^9}, 
   3.993771883368662*^9, {3.9937759522288733`*^9, 3.993775960719859*^9}, {
   3.993776003480214*^9, 
   3.993776027002941*^9}},ExpressionUUID->"d5b174e1-a536-4db9-b1ca-\
094ab24e7b31"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RMWhigh", "=", "0.01"}], ";"}]], "Input",
 CellChangeTimes->{{3.922734760995517*^9, 3.922734795431044*^9}, {
   3.951524922539118*^9, 3.9515249244199944`*^9}, {3.951526212781526*^9, 
   3.951526215602666*^9}, {3.9651853388078003`*^9, 3.965185351186143*^9}, {
   3.992898839142062*^9, 3.9928988417979116`*^9}, 3.9929035054496183`*^9, 
   3.993771836087553*^9, 3.99377188706245*^9, {3.993776017704824*^9, 
   3.9937760184994164`*^9}},ExpressionUUID->"358f50ae-3298-412c-943f-\
f84d1ebd6110"],

Cell["this is", "Text",
 CellChangeTimes->{{3.99377173267314*^9, 3.993771823281145*^9}, {
  3.993771880300687*^9, 
  3.993771881252589*^9}},ExpressionUUID->"d66001ca-9758-4984-aaf6-\
5d5cb41b72f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N100pcIa", " ", "=", " ", 
  RowBox[{
   FractionBox["RMWhigh", 
    RowBox[{"\[Pi]", " ", 
     SuperscriptBox["10", "7"]}]], "vobs", " ", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"dfdt", "[", 
       RowBox[{"fGW", ",", "mchirpav"}], "]"}], 
      RowBox[{"-", "1"}]], ",", 
     RowBox[{"{", 
      RowBox[{"fGW", ",", "fGWlow", ",", "fGWhigh"}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.922740018637163*^9, 3.922740035647366*^9}, {
   3.922740069754537*^9, 3.922740124138809*^9}, {3.922749344589787*^9, 
   3.922749349062147*^9}, {3.965185360572342*^9, 3.965185361840102*^9}, {
   3.992898869998724*^9, 3.992898891328721*^9}, 3.993771754339842*^9, {
   3.993771890252665*^9, 3.993771892022623*^9}},
