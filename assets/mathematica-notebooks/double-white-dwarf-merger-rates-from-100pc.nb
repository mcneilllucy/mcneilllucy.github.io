8fa0b297cb07"],

Cell[BoxData[
 RowBox[{
  RowBox[{"nWD", "=", "10000"}], ";"}]], "Input",
 CellChangeTimes->{{3.9937682569656153`*^9, 3.99376825876329*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"c75c4cbb-a5d1-4e36-8527-008459028500"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InvCDF", "[", "u_", "]"}], " ", "=", " ", 
   RowBox[{"InverseCDF", "[", 
