Cell[BoxData[
 RowBox[{
  RowBox[{"periodUltra", "=", 
   RowBox[{"ProbabilityDistribution", "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"-", "RMWlow"}], "RMWhigh"], " ", 
      RowBox[{"NIa", "[", "fGW", "]"}], 
      SuperscriptBox["fGW", 
       RowBox[{"8", "/", "3"}]], 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["2", 
         RowBox[{"z", " ", "0.001", " ", "60", " ", "60"}]], ")"}], 
       RowBox[{
        RowBox[{"-", "8"}], "/", "3"}]]}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "fGWlow", ",", "Infinity"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
