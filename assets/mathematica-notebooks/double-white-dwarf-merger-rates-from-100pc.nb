Cell[CellGroupData[{

Cell["Discussion : about the number of binaries in 100 pc", "Subsection",
 CellChangeTimes->{{3.993767565901791*^9, 3.993767589384218*^9}, {
  3.993767694492371*^9, 
  3.9937677030316896`*^9}},ExpressionUUID->"62576282-e341-43ee-968e-\
c42d519d44fb"],

Cell[TextData[{
 "Currently there is this ONE reported binary. A key discussion point is \
whether all ",
 StyleBox["short period ",
  FontWeight->"Bold"],
 "binaries have been identified in the 100 pc sample.\nWe might need to \
consider limiting magnitudes etc. "
}], "Text",
 CellChangeTimes->{{3.993767594558263*^9, 3.9937676640139933`*^9}, {
  3.993767706629126*^9, 
  3.993767770180315*^9}},ExpressionUUID->"88e29952-f797-4747-8a6e-\
641abec09b10"]
}, Open  ]],

