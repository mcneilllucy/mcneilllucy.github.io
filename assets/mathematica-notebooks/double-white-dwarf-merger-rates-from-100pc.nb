Cell[BoxData[
 RowBox[{"NproductMW", " ", 
  FractionBox[
   RowBox[{"13", " ", "Gyr"}], 
   RowBox[{"7", " ", "Gyr"}]]}]], "Input",
 CellChangeTimes->{{3.9937755482651033`*^9, 3.993775579214452*^9}},
 CellLabel->
  "In[184]:=",ExpressionUUID->"a1771147-5974-42f9-bf3f-e92f72d7a287"],

Cell[BoxData["9.088392857142854`*^6"], "Output",
 CellChangeTimes->{3.993775579875102*^9},
 CellLabel->
  "Out[184]=",ExpressionUUID->"f8991f7e-e7bc-434a-abf4-41ebc558f0b9"]
}, Open  ]],

Cell["\<\
Then, dividing by the age of the Milky Way ~ 13 Gyr, the average merger rate \
(in /year) should be\
\>", "Text",
 CellChangeTimes->{{3.9937756377812767`*^9, 
  3.993775669799932*^9}},ExpressionUUID->"eab226d3-55e4-4e11-be67-\
110fcd6f32f1"],

