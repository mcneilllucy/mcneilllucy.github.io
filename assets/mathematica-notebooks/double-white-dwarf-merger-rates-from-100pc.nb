Cell["\<\
So that the observable volume assumed to be populated ~ uniformly by WD is\
\>", "Text",
 CellChangeTimes->{{3.922735687893551*^9, 3.922735701227106*^9}, {
  3.993771550815488*^9, 
  3.993771561159556*^9}},ExpressionUUID->"f6054377-a9e7-4ed6-bb16-\
77399f874ff7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"vobs", "=", 
  RowBox[{
   FractionBox["v100pc", "vMW"], "//", "N"}]}]], "Input",
 CellChangeTimes->{{3.922735746078535*^9, 3.922735754306409*^9}, {
  3.993771565504952*^9, 3.993771566062625*^9}},
 CellLabel->
  "In[112]:=",ExpressionUUID->"bfd5be1d-0326-4987-b3ef-a6e9a8bacf32"],

Cell[BoxData["5.9259259259259275`*^-6"], "Output",
 CellChangeTimes->{3.9937715665577383`*^9},
 CellLabel->
  "Out[112]=",ExpressionUUID->"0279c3b1-8c9e-4228-b56a-0af5354d03f8"]
}, Open  ]],

Cell[TextData[{
 "So there are 29 merger products near the Chandrasekar limit in the 100 pc \
sample, which is a volume ~ ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "6"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a91daa05-1953-4737-8bc2-0a7140918315"],
 " of the Milky Way. So the number of these merger products in the whole \
Milky Way should be"
}], "Text",
 CellChangeTimes->{{3.993775233039854*^9, 
  3.99377533316884*^9}},ExpressionUUID->"3874c703-9cd0-4007-bd62-\
e4edf140c0e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NproductMW", " ", "=", " ", 
  FractionBox["Nproduct100pc", "vobs"]}]], "Input",
 CellChangeTimes->{{3.9937753365545807`*^9, 3.9937753749320297`*^9}},
 CellLabel->
  "In[183]:=",ExpressionUUID->"14e4cfce-a378-40b0-8fa3-cf977c230f25"],

Cell[BoxData["4.893749999999998`*^6"], "Output",
 CellChangeTimes->{3.993775375510365*^9},
 CellLabel->
  "Out[183]=",ExpressionUUID->"9dfce712-346d-40ce-9c6a-6f71c5f078b1"]
}, Open  ]],

Cell["\<\
We now consider that they are only observable for up to ~ 7 Gyr, so that the \
total number to have ever existed in ~13 Gyr is roughly\
\>", "Text",
 CellChangeTimes->{{3.993775470839088*^9, 
  3.993775542550433*^9}},ExpressionUUID->"d5f19fb0-f395-42d1-86fe-\
1df59ecc67b2"],

