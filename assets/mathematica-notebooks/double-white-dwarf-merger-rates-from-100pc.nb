Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Generate", " ", "uniform", " ", "random", " ", "draws", " ", "and", " ", 
    "transform", " ", "them"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"drawtab", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InvCDF", "[", 
        RowBox[{"RandomReal", "[", "]"}], "]"}], ",", "2", ",", 
       RowBox[{"{", "nWD", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"draws", "=", 
     RowBox[{"drawtab", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"draws2", "=", 
     RowBox[{"drawtab", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Visualize", " ", "the", " ", "distribution", " ", "of", " ", "your", " ",
      "draws"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Histogram", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{"draws", ",", "draws2"}], "]"}], ",", 
     RowBox[{"ChartStyle", "->", 
      RowBox[{"{", "Gray", "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"LabelStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ")"}], ",", " ", 
        "Black"}], "}"}]}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
        "Style", "[", 
         "\"\<white dwarf mass (\!\(\*SubscriptBox[\(M\), \(\(\\\ \
\)\(\[Sun]\)\(\\\ \)\)]\))\>\"", "]"}], ",", 
        RowBox[{
        "Style", "[", "\"\<\!\(\*StyleBox[\"N\",FontSlant->\"Italic\"]\)\>\"",
          "]"}]}], "}"}]}], ",", 
     RowBox[{"BaseStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"FontSize", "\[Rule]", "20"}], "}"}]}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}]}], "]"}], "\n"}]}]], "Input",
