 CellChangeTimes->{3.993773636157605*^9},
 CellLabel->
  "Out[138]=",ExpressionUUID->"843333b3-8ea2-44ee-9eb5-298c218e201c"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"NIa", "[", "f_", "]"}], ":=", 
  RowBox[{
   FractionBox["RMWhigh", 
    RowBox[{"\[Pi]", " ", 
     SuperscriptBox["10", "7"]}]], "vobs", " ", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"dfdt", "[", 
       RowBox[{
        RowBox[{"0.001", "fGW"}], ",", "0.5"}], "]"}], 
      RowBox[{"-", "1"}]], ",", "fGW"}], "]"}], "0.001"}]}]], "Input",
 CellChangeTimes->{{3.993772458479947*^9, 3.993772520501502*^9}, {
  3.993773056784224*^9, 3.9937730636735973`*^9}, {3.993773212645298*^9, 
  3.9937732179758*^9}},
 CellLabel->
  "In[143]:=",ExpressionUUID->"5f2dd9ea-ee2b-4286-aa2f-9b70b110f4a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  FractionBox["RMWhigh", 
   RowBox[{"\[Pi]", " ", 
    SuperscriptBox["10", "7"]}]], "vobs", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"dfdt", "[", 
      RowBox[{
       RowBox[{"0.001", "fGW"}], ",", "0.5"}], "]"}], 
     RowBox[{"-", "1"}]], ",", "fGW"}], "]"}], "0.001"}]], "Input",
 CellLabel->
  "In[144]:=",ExpressionUUID->"a0c2c7a5-e7ba-402b-b2c1-0137082f9a4e"],

Cell[BoxData[
 RowBox[{"-", 
